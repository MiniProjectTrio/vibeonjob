# ── Backend Environment Variables ──
# Copy this file to .env and fill in your values.

# Neon Postgres connection string (get from Neon dashboard)
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/vibeonjob?sslmode=require

# JWT secret for signing auth tokens (use a long random string)
JWT_SECRET=your-random-secret-key-here

# Google Gemini API
GOOGLE_API_KEY=your_google_api_key_here

# Gemini model override (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# Groq API (fallback LLM — get free key at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# LLM provider order — comma-separated, tried left to right with fallback
# Options: gemini, groq  |  Examples: "gemini,groq", "groq,gemini", "groq"
LLM_PROVIDER_ORDER=gemini,groq

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
