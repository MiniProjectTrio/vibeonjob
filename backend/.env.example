# ── Backend Environment Variables ──
# Copy this file to .env and fill in your values.

# Neon Postgres connection string (get from Neon dashboard)
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/vibeonjob?sslmode=require

# JWT secret for signing auth tokens (use a long random string)
JWT_SECRET=your-random-secret-key-here

# Google Gemini API
GOOGLE_API_KEY=your_google_api_key_here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
